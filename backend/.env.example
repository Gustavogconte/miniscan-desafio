# Origens autorizadas a chamar a API (separadas por vírgula).
MINISCAN_ORIGENS_CORS=http://localhost:3000
# Opcional: padrão para as URLs de prévia da Vercel (uma por deploy).
# MINISCAN_ORIGENS_CORS_REGEX=^https://miniscan-desafio(-[a-z0-9-]+)?\.vercel\.app$

# Supabase: Project Settings > API. A chave service_role ignora o RLS,
# então fica só no servidor e nunca vai para o front-end ou para o Git.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
MINISCAN_BUCKET=miniscan-files
